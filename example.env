# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-***

# ---------------------------------------------------------------------------
# Runtime mode
# - Use `dev` for local Docker validation and smoke tests.
# - Switch to `prd` before syncing secrets to Modal or exposing the app publicly.
# ---------------------------------------------------------------------------
RUNTIME_ENV=dev

# ---------------------------------------------------------------------------
# Optional model-provider scaffolding
# Track provider/model/API endpoints here without storing provider secrets in
# source control. Use *_API_KEY_ENV to document which env var supplies a secret.
# ---------------------------------------------------------------------------
# DEFAULT_MODEL_PROVIDER=openai
# DEFAULT_MODEL_ID=gpt-5.6-sol
# DEFAULT_MODEL_BASE_URL=
# DEFAULT_MODEL_API_KEY_ENV=OPENAI_API_KEY
# EMBEDDING_MODEL_PROVIDER=openai
# EMBEDDING_MODEL_ID=text-embedding-3-small
# EMBEDDING_MODEL_BASE_URL=
# EMBEDDING_MODEL_API_KEY_ENV=OPENAI_API_KEY

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# WebSearch Agent uses Parallel SDK when authenticated,
# and falls back to Parallel's keyless MCP server for local development.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# ENABLE_DEPLOY_CHECK=True
# ENABLE_SCHEDULED_EVALS=False
# EVALS_TAG=smoke
# EVALS_CASE_TIMEOUT_SECONDS=90
# EVALS_SUITE_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Database
# Supports local Postgres or external serverless Postgres/pgvector providers
# such as Neon. Keep PGSSLMODE=require for Neon unless your provider documents
# a different TLS mode.
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg
# PGSSLMODE=require
# VECTOR_DB_PROVIDER=neon-postgres
